# Multi-stage Dockerfile for Backend API Server
# Build Stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root and server package files for dependency caching
COPY package.json ./
COPY server/package.json ./server/
COPY server/prisma ./server/prisma/

RUN npm install --workspace=server

COPY server ./server

WORKDIR /app/server
RUN npx prisma generate
RUN npm run build

# Production Stage
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5001

# Install dumb-init for clean PID 1 signal handling
RUN apk add --no-cache dumb-init

# Copy package files and install only production dependencies
COPY package.json ./
COPY server/package.json ./server/
COPY server/prisma ./server/prisma/

RUN npm install --workspace=server --omit=dev

# Copy generated prisma client and built assets from builder
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/node_modules/.prisma ./server/node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

WORKDIR /app/server

# Security: run as unprivileged non-root node user
USER node

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5001/api/healthz || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
